server:
  host: "0.0.0.0"
  port: 8100

storage:
  neo4j:
    # For local development: bolt://localhost:7687
    # For docker-compose: bolt://neo4j:7687 (use service name)
    uri: "bolt://localhost:7687"
    user: "neo4j"
    password: "your-password"
  buffer:
    path: "./data/buffer.db"
  tag_dict:
    path: "./data/tag_dict.json"

llm:
  base_url: "https://api.example.com/v1"
  model: "your-model-name"
  api_key: "sk-your-api-key"
  temperature: 0.3
